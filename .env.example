# cp .env.example .env
# Required for M4 (RAGAS eval) and M5 (Enrichment LLM calls)
OPENAI_API_KEY=sk-...

# Provider tương thích OpenAI (ví dụ OpenRouter); để trống để dùng OpenAI
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen3-30b-a3b-instruct-2507
# EVAL_MODEL=qwen/qwen3-235b-a22b-2507

# Tùy chọn cho free tier / provider khác
# EVAL_SUPPORTS_N=0        # provider không hỗ trợ n>1 (Gemini)
# LLM_RPM=4                # giới hạn request/phút cho generation
# EVAL_RPM=12              # giới hạn request/phút cho judge RAGAS
# ENRICHMENT_API_KEY=...   # provider riêng cho M5 (mặc định dùng OPENAI_*)
# ENRICHMENT_BASE_URL=...
# ENRICHMENT_MODEL=...
